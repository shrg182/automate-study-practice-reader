[
  {
    "text": "东复侵地",
    "background": "#a8beff",
    "bold": false,
    "underline": false
  },
  {
    "text": "行之十年，秦民大说，道不拾遗，山无盗贼，家给人足",
    "background": "",
    "bold": false,
    "underline": true
  },
  {
    "text": "齐败魏兵於马陵，虏其太子申，杀将军庞涓",
    "background": "",
    "bold": true,
    "underline": false
  },
  {
    "text": "商君相秦十年，宗室贵戚多怨望者",
    "background": "#ffc2a8",
    "bold": false,
    "underline": false
  },
  {
    "text": "後五月而秦孝公卒",
    "background": "",
    "bold": false,
    "underline": true
  }
]
