field=\"supplement\" data-placeholder=\"Add links or supplementary notes\"></td></tr><tr data-paragraph=\"52\" data-entry-id=\"402\"><td data-label=\"Date\">December 19, 1861</td><td data-label=\"Battle\"><a href=\"https://en.wikipedia.org/wiki/Skirmish_at_Blackwater_Creek\" target=\"_blank\" rel=\"noopener\" contenteditable=\"false\">Skirmish at Blackwater Creek</a></td><td data-label=\"State\">Missouri</td><td data-label=\"Result\">Union</td><td data-label=\"Class\">Other USA/CSA</td><td data-label=\"Notes\">Union forces under General Pope capture a newly recruited Missouri State Guard regiment.</td><td data-label=\"Commentary\" class=\"reader-editable-cell\" contenteditable=\"true\" spellcheck=\"true\" data-field=\"commentary\" data-placeholder=\"Add commentary\"></td><td data-label=\"Manual Supplement\" class=\"reader-editable-cell\" contenteditable=\"true\" spellcheck=\"true\" data-field=\"supplement\" data-placeholder=\"Add links or supplementary notes\"></td></tr><tr data-paragraph=\"53\" data-entry-id=\"403\"><td data-label=\"Date\">December 28, 1861</td><td data-label=\"Battle\"><a href=\"https://en.wikipedia.org/wiki/Battle_of_Sacramento_(Kentucky)\" target=\"_blank\" rel=\"noopener\" contenteditable=\"false\">Battle of Sacramento</a></td><td data-label=\"State\">Kentucky</td><td data-label=\"Result\">Confederate</td><td data-label=\"Class\">Other USA/CSA</td><td data-label=\"Notes\">Nathan Bedford Forrest's first victory. The Federals are surprised and quickly routed.</td><td data-label=\"Commentary\" class=\"reader-editable-cell\" contenteditable=\"true\" spellcheck=\"true\" data-field=\"commentary\" data-placeholder=\"Add commentary\"></td><td data-label=\"Manual Supplement\" class=\"reader-editable-cell\" contenteditable=\"true\" spellcheck=\"true\" data-field=\"supplement\" data-placeholder=\"Add links or supplementary notes\"></td></tr><tr data-paragraph=\"54\" data-entry-id=\"470\"><td data-label=\"Date\">August 1861</td><td data-label=\"Battle\"><a