pellcheck=\"true\" data-field=\"supplement\" data-placeholder=\"Add links or supplementary notes\"></td></tr><tr data-paragraph=\"18\" data-entry-id=\"18\"><td data-label=\"Date\">September 13 –20, 1861</td><td data-label=\"Battle\"><a href=\"https://en.wikipedia.org/wiki/First_Battle_of_Lexington\" target=\"_blank\" rel=\"noopener\" contenteditable=\"false\">First Battle of Lexington</a></td><td data-label=\"State\">Missouri</td><td data-label=\"Result\">Confederate</td><td data-label=\"Class\">CWSAC C</td><td data-label=\"Notes\">Union forces badly defeated by Missouri State Guard.</td><td data-label=\"Commentary\" class=\"reader-editable-cell\" contenteditable=\"true\" spellcheck=\"true\" data-field=\"commentary\" data-placeholder=\"Add commentary\"></td><td data-label=\"Manual Supplement\" class=\"reader-editable-cell\" contenteditable=\"true\" spellcheck=\"true\" data-field=\"supplement\" data-placeholder=\"Add links or supplementary notes\"></td></tr><tr data-paragraph=\"19\" data-entry-id=\"19\"><td data-label=\"Date\">September 17, 1861</td><td data-label=\"Battle\"><a href=\"https://en.wikipedia.org/wiki/Action_at_Blue_Mills_Landing\" target=\"_blank\" rel=\"noopener\" contenteditable=\"false\">Action at Blue Mills Landing</a></td><td data-label=\"State\">Missouri</td><td data-label=\"Result\">Confederate</td><td data-label=\"Class\">CWSAC D</td><td data-label=\"Notes\">Minor Missouri State Guard victory.</td><td data-label=\"Commentary\" class=\"reader-editable-cell\" contenteditable=\"true\" spellcheck=\"true\" data-field=\"commentary\" data-placeholder=\"Add commentary\"></td><td data-label=\"Manual Supplement\" class=\"reader-editable-cell\" contenteditable=\"true\" spellcheck=\"true\" data-field=\"supplement\" data-placeholder=\"Add links or supplementary notes\"></td></tr><tr data-paragraph=\"20\" data-entry-id=\"20\"><td data-label=\"Date\">September 19, 1861</td><td data-label=\"Battle\"><a href=\"https://en.wikipedia.org/wiki/Battle_of_Barbourville